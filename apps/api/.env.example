# Copiar a .env y completar con valores reales. Nunca versionar secretos.
# cp .env.example .env

# Aplicación
NODE_ENV=development
PORT=3001

# Base de datos (PostgreSQL/Supabase)
# No cambiar URLs existentes en .env real; solo placeholders aquí.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DB
DIRECT_URL=postgresql://USER:PASSWORD@HOST:PORT/DB

# Hashing Argon2id (algoritmo fijo argon2id)
PASSWORD_HASH_ALGORITHM=argon2id
PASSWORD_HASH_MEMORY_COST=65536
PASSWORD_HASH_TIME_COST=3
PASSWORD_HASH_PARALLELISM=1

# Autenticación JWT (secreto obligatorio, sin valor por defecto)
# Generar con: openssl rand -hex 32 (un secreto distinto por entorno; pegar el resultado en .env)
JWT_ACCESS_SECRET=replace_with_a_long_random_secret_min_32_chars
JWT_ISSUER=sistema-asistencia
JWT_AUDIENCE=sistema-asistencia-web
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Cookies
# COOKIE_SECURE: true/false; si se omite, true en producción o SameSite=none, false en local.
# COOKIE_DOMAIN: vacío en local; fijarlo en producción si aplica (ej. .midominio.com).
COOKIE_SAMESITE=lax
COOKIE_SECURE=
COOKIE_DOMAIN=

# CORS (lista separada por comas)
CORS_ORIGINS=http://localhost:3000

# Rate limiting (límites por ventana de tiempo en ms)
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
AUTH_LOGIN_LIMIT=10
AUTH_LOGIN_TTL_MS=60000
AUTH_REFRESH_LIMIT=20
AUTH_REFRESH_TTL_MS=60000

# Observabilidad (opcional; vacío desactiva claves, sin secretos hardcodeados)
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
OBSERVE_SERVICE_ID=api
